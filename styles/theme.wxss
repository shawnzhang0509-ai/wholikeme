:root {
  --bg: #fff8f1;
  --surface: #fffdf9;
  --ink: #2d2327;
  --soft-ink: #5c4c53;
  --muted: #8c7d84;
  --line: rgba(45, 35, 39, 0.10);
  --accent: #e86f67;
  --accent-strong: #c94b46;
  --warm: #f2b8a0;
  --gold: #d9a441;
  --success: #4f9d78;
  --shadow: 0 18rpx 60rpx rgba(122, 74, 61, 0.14);
  --radius-lg: 32rpx;
  --radius-md: 24rpx;
  --radius-sm: 16rpx;
  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space-md: 24rpx;
  --space-lg: 40rpx;
  --space-xl: 64rpx;
  --font-sans: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
}
