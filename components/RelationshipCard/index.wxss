.rel-card {
  border-radius: 40rpx;
  padding: 44rpx;
  min-height: 520rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  background: linear-gradient(160deg, #fffdf9, #ffe9df);
  border: 1rpx solid rgba(232, 111, 103, 0.18);
  box-shadow: var(--shadow);
}
.is-unlocked { background: linear-gradient(160deg, #fff3ec, #ffd4ca); }
.top { text-align: center; padding-top: 40rpx; }
.secret { font-size: 76rpx; font-weight: 900; color: var(--accent-strong); }
.name { margin-top: 18rpx; font-size: 44rpx; font-weight: 900; }
.meta { margin-top: 36rpx; color: var(--soft-ink); font-size: 26rpx; line-height: 1.8; text-align: center; }
.hint { margin-top: 28rpx; text-align: center; color: var(--muted); }
.status {
  align-self: center;
  margin-top: 42rpx;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(45, 35, 39, 0.08);
  color: var(--ink);
  font-weight: 800;
}
.more { margin-top: 34rpx; text-align: center; color: var(--accent-strong); font-weight: 800; }
