.showcase {
  margin-top: 28rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(165deg, rgba(255, 253, 249, 0.98), rgba(242, 184, 160, 0.12));
  border: 1rpx solid var(--line);
}
.showcase-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--ink);
}
.showcase-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: var(--soft-ink);
}
.flow {
  margin-top: 24rpx;
  display: flex;
  align-items: stretch;
  gap: 12rpx;
}
.mini-card {
  flex: 1;
  padding: 20rpx 18rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--line);
  min-height: 220rpx;
  box-sizing: border-box;
}
.mini-card.is-unlit {
  background: rgba(45, 35, 39, 0.06);
  color: var(--muted);
}
.mini-card.is-lit {
  background: rgba(255, 255, 255, 0.92);
  border-color: rgba(232, 111, 103, 0.28);
  box-shadow: 0 12rpx 36rpx rgba(122, 74, 61, 0.1);
  color: var(--ink);
}
.mini-label { font-size: 20rpx; opacity: 0.85; }
.mini-name {
  margin-top: 12rpx;
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}
.mini-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.45;
}
.mini-tag {
  display: inline-block;
  margin-top: 14rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  background: rgba(45, 35, 39, 0.08);
}
.mini-tag.lit {
  background: rgba(232, 111, 103, 0.14);
  color: var(--accent-strong);
}
.mini-note {
  margin-top: 12rpx;
  font-size: 20rpx;
  line-height: 1.45;
  opacity: 0.9;
}
.arrow-col {
  width: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.arrow {
  font-size: 32rpx;
  color: var(--accent);
  font-weight: 700;
}
.arrow-caption {
  margin-top: 8rpx;
  text-align: center;
  font-size: 18rpx;
  line-height: 1.35;
  color: var(--muted);
}
.showcase-foot {
  margin-top: 18rpx;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.55;
}
