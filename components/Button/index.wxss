.btn {
  width: 100%;
  height: 104rpx;
  border-radius: 999rpx;
  border: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--ink);
  color: var(--surface);
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: var(--shadow);
}
.btn::after { border: 0; }
.btn--ghost {
  background: var(--surface);
  color: var(--ink);
  border: 2rpx solid rgba(45, 35, 39, 0.18);
  box-shadow: 0 8rpx 24rpx rgba(45, 35, 39, 0.06);
}
.btn--secondary {
  background: #fff;
  color: var(--accent-strong);
  border: 2rpx solid var(--accent);
  box-shadow: 0 10rpx 28rpx rgba(232, 111, 103, 0.12);
}
.btn--accent { background: linear-gradient(135deg, var(--accent), var(--accent-strong)); }
.is-loading { opacity: 0.72; }
.btn[disabled],
.btn[disabled].btn--accent,
.btn[disabled].btn--secondary,
.btn[disabled].btn--ghost {
  opacity: 1;
  background: rgba(45, 35, 39, 0.08) !important;
  color: rgba(45, 35, 39, 0.38) !important;
  border: 2rpx solid rgba(45, 35, 39, 0.12) !important;
  box-shadow: none !important;
}
