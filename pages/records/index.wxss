.top-actions { margin: 24rpx 0 32rpx; }
.checking { color: var(--muted); font-size: 24rpx; margin-bottom: 20rpx; }
.card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: rgba(45, 35, 39, 0.05);
  border: 1rpx solid var(--line);
  color: var(--muted);
}
.card.is-lit {
  background: rgba(255, 253, 249, 0.95);
  border-color: rgba(232, 111, 103, 0.35);
  color: var(--ink);
  box-shadow: var(--shadow);
}
.card-head { display: flex; justify-content: space-between; align-items: center; }
.card-name { font-size: 34rpx; font-weight: 800; }
.card-tag { font-size: 22rpx; color: var(--muted); }
.card-sub { margin-top: 10rpx; font-size: 26rpx; line-height: 1.55; }
.confirm {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed var(--line);
}
.confirm-title { font-size: 28rpx; font-weight: 700; color: var(--ink); }
.fragment { margin-top: 8rpx; font-size: 24rpx; color: var(--soft-ink); }
.confirm-actions { margin-top: 16rpx; }
.empty { margin-top: 80rpx; text-align: center; color: var(--muted); font-size: 26rpx; line-height: 1.7; }
.boundary { margin-top: 36rpx; font-size: 22rpx; color: var(--muted); line-height: 1.65; }
