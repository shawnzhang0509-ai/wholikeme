.form { margin-top: 40rpx; }
.field { margin-bottom: 24rpx; }
.label { margin-bottom: 12rpx; color: var(--muted); font-size: 24rpx; }
.hint { margin-top: 10rpx; color: var(--muted); font-size: 22rpx; line-height: 1.55; }
.input {
  height: 92rpx;
  padding: 0 28rpx;
  border-radius: 22rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  font-size: 28rpx;
}
.candidate {
  margin-top: 14rpx;
  padding: 22rpx 26rpx;
  border-radius: 18rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  font-size: 26rpx;
}
.candidate.is-selected {
  border-color: var(--accent);
  background: rgba(232, 111, 103, 0.08);
}
.confirmed {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: rgba(79, 157, 120, 0.08);
  font-size: 26rpx;
}
.crush-block {
  margin-top: 28rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid var(--line);
}
.block-title { font-size: 28rpx; font-weight: 700; margin-bottom: 16rpx; }
.boundary {
  margin-top: 32rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: rgba(45, 35, 39, 0.04);
  color: var(--soft-ink);
  font-size: 22rpx;
  line-height: 1.65;
}
.action { margin-top: 24rpx; }
