.form { margin-top: 56rpx; }
.field { margin-bottom: 28rpx; }
.row { display: flex; gap: 24rpx; }
.half { flex: 1; }
.label { margin-bottom: 14rpx; color: var(--muted); font-size: 24rpx; }
.hint { margin-top: 12rpx; color: var(--muted); font-size: 22rpx; line-height: 1.5; }
.input {
  height: 96rpx;
  padding: 0 28rpx;
  border-radius: 24rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  font-size: 30rpx;
}
.candidate-box { margin-top: 24rpx; }
.candidate {
  margin-top: 16rpx;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  font-size: 28rpx;
}
.candidate.is-selected {
  border-color: var(--accent, #c45);
  background: rgba(196, 85, 85, 0.06);
}
.none-row { margin: 20rpx 0 8rpx; }
.link { color: var(--accent, #c45); font-size: 26rpx; text-decoration: underline; }
.create-panel {
  margin-top: 20rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: var(--surface);
  border: 1rpx dashed var(--line);
}
.picker-line {
  margin: 16rpx 0;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  font-size: 28rpx;
}
.confirmed {
  margin: 28rpx 0;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  background: rgba(46, 125, 50, 0.08);
  border: 1rpx solid rgba(46, 125, 50, 0.2);
}
.confirmed-text { font-size: 30rpx; font-weight: 600; }
