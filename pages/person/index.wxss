.identity {
  margin-top: 56rpx;
  padding: 52rpx 40rpx;
  border-radius: 40rpx;
  text-align: center;
  background: var(--surface);
  border: 1rpx solid var(--line);
  box-shadow: var(--shadow);
}
.secret { font-size: 76rpx; font-weight: 900; color: var(--accent-strong); }
.name { margin-top: 14rpx; font-size: 44rpx; font-weight: 900; }
.meta { margin-top: 12rpx; color: var(--muted); font-size: 26rpx; }
.hint { margin-top: 26rpx; color: var(--soft-ink); font-size: 26rpx; }
ui-button { margin-top: 22rpx; }
