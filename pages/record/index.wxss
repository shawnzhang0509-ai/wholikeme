.form { margin-top: 36rpx; }
.section { margin-bottom: 40rpx; }
.section-head { font-size: 34rpx; font-weight: 800; margin-bottom: 8rpx; }
.section-sub { color: var(--muted); font-size: 24rpx; line-height: 1.55; margin-bottom: 20rpx; }
.field { margin-bottom: 22rpx; }
.label { margin-bottom: 10rpx; color: var(--muted); font-size: 24rpx; }
.hint { margin-top: 8rpx; color: var(--muted); font-size: 22rpx; line-height: 1.5; }
.input {
  height: 92rpx;
  padding: 0 28rpx;
  border-radius: 22rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  font-size: 28rpx;
}
.anchor-summary {
  padding: 22rpx 26rpx;
  border-radius: 20rpx;
  background: rgba(45, 35, 39, 0.04);
  font-size: 26rpx;
  line-height: 1.6;
}
.candidate {
  margin-top: 12rpx;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  font-size: 26rpx;
}
.candidate.is-selected { border-color: var(--accent); background: rgba(232, 111, 103, 0.07); }
.confirmed { margin-top: 12rpx; font-size: 26rpx; color: var(--success); }
.boundary {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background: rgba(45, 35, 39, 0.04);
  color: var(--soft-ink);
  font-size: 22rpx;
  line-height: 1.65;
}
.action { margin-top: 22rpx; }
.success-box {
  margin-top: 48rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid var(--line);
}
.success-title { font-size: 36rpx; font-weight: 800; }
.success-sub { margin-top: 12rpx; color: var(--soft-ink); font-size: 28rpx; line-height: 1.65; }
